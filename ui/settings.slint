import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import {
    BackButton, Button, Caption, ConfirmButton, ListItem, NumberField, Panel, ScrollPanel,
    SectionTitle, Segmented, SettingRow, TabBar, TextField, Toggle,
} from "widgets.slint";

component GeneralTab inherits VerticalLayout {
    spacing: Theme.spacing;

    SectionTitle { text: "TIMING"; }
    SettingRow {
        label: "Preset";
        Segmented {
            options: ["Fast", "Balanced", "Stable", "Custom"];
            current: AppState.preset-index;
            selected(i) => { AppState.select-preset(i); }
        }
    }
    SettingRow {
        label: "Key hold";
        NumberField { value: AppState.key-ms; minimum: 1; maximum: 10000; edited(v) => { AppState.set-int("key", v); } }
    }
    SettingRow {
        label: "Delay between keys";
        NumberField { value: AppState.gap-ms; maximum: 10000; edited(v) => { AppState.set-int("gap", v); } }
    }
    SettingRow {
        label: "Delay between loops";
        NumberField { value: AppState.loop-ms; maximum: 60000; edited(v) => { AppState.set-int("loop", v); } }
    }
    SettingRow {
        label: "Modifier lead";
        NumberField { value: AppState.modifier-ms; maximum: 1000; edited(v) => { AppState.set-int("modifier", v); } }
    }
    Caption { text: "Modifier lead is the pause between pressing Ctrl/Alt/Shift/Super and the key of a combination. Presets are starting points; verify timings in your game."; }

    SectionTitle { text: "RUN"; }
    SettingRow {
        label: "Loop";
        Toggle { checked: AppState.loop-enabled; toggled(v) => { AppState.set-bool("loop", v); } }
    }
    SettingRow {
        label: "Repetitions";
        NumberField {
            value: AppState.repeat-count;
            maximum: 1000000;
            suffix: "×";
            enabled: AppState.loop-enabled;
            edited(v) => { AppState.set-int("repeat", v); }
        }
    }
    Caption { text: "0 repeats until stopped. With Loop off the sequence runs once."; }
    SettingRow {
        label: "Start delay";
        NumberField { value: AppState.start-delay-ms; maximum: 30000; edited(v) => { AppState.set-int("start-delay", v); } }
    }
    SettingRow {
        label: "Activation";
        Segmented {
            options: ["Toggle", "Hold to run"];
            current: AppState.activation-index;
            selected(i) => { AppState.set-int("activation", i); }
        }
    }

    SectionTitle { text: "RESET"; }
    HorizontalLayout {
        ConfirmButton {
            text: "Reset settings to defaults";
            confirm-text: "Click again to reset";
            confirmed => { AppState.reset-defaults(); }
        }
        Rectangle { }
    }
    Caption { text: "The custom sequence and saved profiles are kept. Settings file: " + AppState.config-path; }
}

component HotkeyRow inherits SettingRow {
    in property <string> target;
    in property <string> value;
    TextField {
        preferred-width: 130px;
        horizontal-stretch: 0;
        text: AppState.capture-target == root.target ? "Press a key…" : root.value;
        highlight: AppState.capture-target == root.target;
        enabled: AppState.capture-target == "";
        accepted(t) => { AppState.set-text("hotkey-" + root.target, t); }
    }
    Button {
        text: AppState.capture-target == root.target ? "Cancel" : "Capture";
        enabled: AppState.capture-target == "" || AppState.capture-target == root.target;
        clicked => {
            if AppState.capture-target == root.target {
                AppState.cancel-capture();
            } else {
                AppState.capture(root.target);
            }
        }
    }
}

component HotkeysTab inherits VerticalLayout {
    spacing: Theme.spacing;

    SectionTitle { text: "GLOBAL HOTKEYS"; }
    HotkeyRow { label: "Start / stop"; target: "start"; value: AppState.hotkey-start; }
    HotkeyRow { label: "Emergency stop"; target: "emergency"; value: AppState.hotkey-emergency; }
    Text {
        text: AppState.hotkey-status;
        color: AppState.hotkey-ok ? Theme.text-secondary : Theme.text-strong;
        font-size: Theme.font-label;
        wrap: word-wrap;
    }
    Caption {
        text: "Click Capture and press the key or combination (Esc cancels), or type it, e.g. F6 or Ctrl+F6. Emergency stop always stops and releases every key. Keys used by the sequence cannot be hotkeys.";
    }
}

component InputTab inherits VerticalLayout {
    spacing: Theme.spacing;

    SectionTitle { text: "INPUT BACKEND"; }
    SettingRow {
        label: "Backend";
        Segmented {
            options: ["XTest", "uinput"];
            current: AppState.backend-index;
            selected(i) => { AppState.set-int("backend", i); }
        }
    }
    Caption {
        text: "XTest sends synthetic X11 events and needs no permissions. uinput creates a virtual keyboard and mouse in the kernel; it needs write access to /dev/uinput (see README).";
    }

    SectionTitle { text: "FOCUS PROTECTION"; }
    SettingRow {
        label: "Focus protection";
        Toggle { checked: AppState.focus-protection; toggled(v) => { AppState.set-bool("focus-protection", v); } }
    }
    SettingRow {
        label: "When focus is lost";
        Segmented {
            options: ["Stop", "Pause"];
            current: AppState.focus-loss-index;
            enabled: AppState.focus-protection;
            selected(i) => { AppState.set-int("focus-loss", i); }
        }
    }
    SettingRow {
        label: "Target window";
        TextField {
            preferred-width: 130px;
            horizontal-stretch: 0;
            text: AppState.target-class;
            placeholder: "any window";
            enabled: AppState.focus-protection;
            accepted(t) => { AppState.set-text("target-class", t); }
        }
        Button {
            text: AppState.detecting ? "Focus it…" : "Detect";
            enabled: AppState.focus-protection && !AppState.detecting;
            clicked => { AppState.detect-target(); }
        }
    }
    Caption {
        text: "Input only goes to the window that was focused when the macro started. Optionally restrict that window by its WM_CLASS (e.g. sober): click Detect and focus the game within 3 seconds.";
    }
    if AppState.input-message != "": Text {
        text: AppState.input-message;
        color: Theme.text-secondary;
        font-size: Theme.font-label;
        wrap: word-wrap;
    }
}

component ProfilesTab inherits VerticalLayout {
    in-out property <string> name-input;
    in-out property <string> path-input: "~/";
    property <bool> has-selection: AppState.profile-index >= 0 && AppState.profile-index < AppState.profiles.length;
    spacing: Theme.spacing;

    SectionTitle { text: "SEQUENCE PROFILES"; }
    Panel {
        height: 128px;
        if AppState.profiles.length == 0: Text {
            width: parent.width;
            height: parent.height;
            text: "No saved profiles yet";
            color: Theme.text-muted;
            font-size: Theme.font-label;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        ScrollPanel {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            content-spacing: 1px;
            for name[i] in AppState.profiles: ListItem {
                text: name;
                detail: name == AppState.active-profile ? "in use" : "";
                selected: i == AppState.profile-index;
                clicked => {
                    AppState.profile-index = i;
                    root.name-input = name;
                }
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.spacing-small;
        Button { text: "Load"; enabled: root.has-selection; clicked => { AppState.profile-load(AppState.profile-index); } }
        Button { text: "Duplicate"; enabled: root.has-selection; clicked => { AppState.profile-duplicate(AppState.profile-index); } }
        Rectangle { }
        ConfirmButton {
            text: "Delete";
            confirm-text: "Delete?";
            enabled: root.has-selection;
            confirmed => { AppState.profile-delete(AppState.profile-index); }
        }
    }
    HorizontalLayout {
        spacing: Theme.spacing-small;
        TextField {
            text: root.name-input;
            placeholder: "Profile name";
            edited(t) => { root.name-input = t; }
            accepted(t) => { root.name-input = t; }
        }
        Button { text: "Save"; clicked => { AppState.profile-save(root.name-input); } }
        Button {
            text: "Rename";
            enabled: root.has-selection;
            clicked => { AppState.profile-rename(AppState.profile-index, root.name-input); }
        }
    }
    Caption { text: "Save stores the custom sequence and timing under the name (replacing a profile with the same name). Load makes it the active custom sequence."; }

    SectionTitle { text: "IMPORT / EXPORT"; }
    HorizontalLayout {
        spacing: Theme.spacing-small;
        TextField {
            text: root.path-input;
            placeholder: "File or folder path";
            edited(t) => { root.path-input = t; }
            accepted(t) => { root.path-input = t; }
        }
        Button {
            text: "Export";
            enabled: root.has-selection;
            clicked => { AppState.profile-export(AppState.profile-index, root.path-input); }
        }
        Button { text: "Import"; clicked => { AppState.profile-import(root.path-input); } }
    }
    if AppState.profile-message != "": Text {
        text: AppState.profile-message;
        color: AppState.profile-error ? Theme.text-strong : Theme.text-secondary;
        font-size: Theme.font-label;
        wrap: word-wrap;
    }
    Caption { text: "Export writes the selected profile to a .toml file (a folder path uses the profile name). Profiles are stored in " + AppState.profiles-dir; }
}

component AdvancedTab inherits VerticalLayout {
    spacing: Theme.spacing;

    SectionTitle { text: "CUSTOM SEQUENCE"; }
    SettingRow {
        label: "Use custom sequence";
        Toggle { checked: AppState.custom-enabled; toggled(v) => { AppState.set-bool("custom", v); } }
    }
    Panel {
        HorizontalLayout {
            padding: 10px;
            spacing: Theme.spacing;
            Text {
                text: AppState.custom-summary;
                color: AppState.sequence-valid ? Theme.text-secondary : Theme.text-strong;
                font-size: Theme.font-label;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            Button { text: "Edit sequence"; clicked => { AppState.navigate(2); } }
        }
    }
    Caption {
        text: "When off, the default sequence 5 › Click › 6 › Click › 7 › Click › 8 › Click › 9 › Click › 0 › Click runs (left mouse clicks). Turning this off never deletes your custom steps.";
    }
}

export component SettingsPage inherits Rectangle {
    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        HorizontalLayout {
            spacing: 8px;
            BackButton { clicked => { AppState.navigate(0); } }
            TabBar {
                tabs: ["General", "Hotkeys", "Input", "Profiles", "Advanced"];
                current: AppState.settings-tab;
                selected(i) => { AppState.settings-tab = i; }
            }
            Rectangle { }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        ScrollPanel {
            vertical-stretch: 1;
            if AppState.settings-tab == 0: GeneralTab { }
            if AppState.settings-tab == 1: HotkeysTab { }
            if AppState.settings-tab == 2: InputTab { }
            if AppState.settings-tab == 3: ProfilesTab { }
            if AppState.settings-tab == 4: AdvancedTab { }
        }
    }
}
